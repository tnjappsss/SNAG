# Copy to keystore.properties and fill in. Gitignored.
# Generate the keystore first - see README, "Releasing".
#
# storeFile may be absolute, or relative to this file (the repo root).
# keyPassword can be left blank: keytool creates a PKCS12 store, which uses the
# same password for the store and the key.
storeFile=../snag-release.jks
storePassword=
keyAlias=snag
keyPassword=
