<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView talks to snag.py over plain HTTP on the loopback interface, which
     never leaves the device. Everything else must be HTTPS. Note this governs the
     Java/WebView stack only; yt-dlp uses Python sockets and is unaffected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
