# Android / Gradle
*.iml
.gradle/
build/
local.properties
.idea/
.cxx/

# Signing material never goes in version control
keystore.properties
*.jks
*.keystore

# Python
__pycache__/
*.pyc

# ffmpeg payload is fetched and generated by tools/package_ffmpeg.py, not committed
app/src/main/assets/ffmpeg-*.zip
app/src/main/jniLibs/

# release artifacts, attached to GitHub Releases rather than committed
dist/
